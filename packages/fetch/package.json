{
  "name": "@odata2ts/http-client-fetch",
  "version": "0.9.2",
  "description": "HTTP client based on fetch and consumable by odata2ts",
  "keywords": [
    "http client",
    "fetch",
    "odata",
    "ts",
    "odata2ts"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "*.md",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn compile",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "int-test": "vitest run --dir int-test",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-base": "^0.5.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@odata2ts/odata-core": "^0.3.7",
    "@types/node": "^24",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
