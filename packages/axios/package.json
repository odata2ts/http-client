{
  "name": "@odata2ts/http-client-axios",
  "version": "0.16.0",
  "description": "Axios based odata HTTP client consumable by odata2ts",
  "keywords": [
    "http client",
    "axios",
    "odata",
    "odata2ts",
    "ts",
    "typescript"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "*.md",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn compile",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-base": "^0.7.0",
    "@odata2ts/http-client-common": "^0.1.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "axios": "^1.18.1",
    "madge": "^8.0.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "axios": "^0.27.0 || ^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
