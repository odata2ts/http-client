{
  "name": "@odata2ts/http-client-common",
  "version": "0.1.1",
  "description": "Transport-agnostic building blocks shared by all odata2ts HTTP clients",
  "keywords": [
    "http client",
    "common",
    "odata",
    "ts",
    "odata2ts"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "*.md",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn compile",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-api": "^0.6.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "madge": "^8.0.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
