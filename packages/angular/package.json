{
  "name": "@odata2ts/http-client-angular",
  "version": "0.2.1",
  "description": "Angular based OData HTTP client consumable by odata2ts",
  "keywords": [
    "http client",
    "angular",
    "odata",
    "odata2ts",
    "ts",
    "typescript"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/odata2ts-http-client-angular.d.ts",
      "default": "./dist/fesm2022/odata2ts-http-client-angular.mjs"
    }
  },
  "main": "./dist/fesm2022/odata2ts-http-client-angular.mjs",
  "types": "./dist/types/odata2ts-http-client-angular.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && ng-packagr -p ng-package.json && rimraf dist/README.md dist/LICENSE",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib dist coverage",
    "compile": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-api": "^0.7.1",
    "@odata2ts/http-client-common": "^0.2.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@types/node": "^24",
    "madge": "^8.0.0",
    "ng-packagr": "^22.0.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@angular/common": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
