{
  "name": "@odata2ts/http-client-angular",
  "version": "0.14.0",
  "description": "Angular based odata HTTP client consumable by odata2ts",
  "keywords": [
    "http client",
    "angular",
    "odata",
    "odata2ts",
    "ts",
    "typescript"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "*.md",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn compile && ng-packagr -p ng-package.json",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "int-test": "vitest run --dir int-test",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-api": "^0.6.5",
    "@odata2ts/http-client-base": "^0.5.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@types/node": "^24",
    "madge": "^8.0.0",
    "ng-packagr": "^20.0.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@angular/common": "^18.0.0 || ^19.0.0 || ^20.0.0",
    "@angular/core": "^18.0.0 || ^19.0.0 || ^20.0.0",
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
