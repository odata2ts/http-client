{
  "name": "@odata2ts/http-client-jquery",
  "version": "0.13.0",
  "description": "JQuery based http client usable by odata2ts",
  "keywords": [
    "http client",
    "jquery",
    "odata2ts",
    "ui5",
    "ts",
    "typescript"
  ],
  "repository": "git@github.com:odata2ts/http-client.git",
  "license": "MIT",
  "author": "texttechne",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "*.md",
    "lib",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn compile",
    "check-circular-deps": "madge ./src --extensions ts --circular",
    "clean": "rimraf lib coverage",
    "compile": "tsc",
    "test": "vitest run",
    "unit-test": "vitest run --dir test"
  },
  "dependencies": {
    "@odata2ts/http-client-base": "^0.5.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.34",
    "@types/node": "^24",
    "jquery": "~3.6.4",
    "jsdom": "^30.0.0",
    "madge": "^8.0.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "jquery": ">1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
